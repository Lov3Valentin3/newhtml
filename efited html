        function generateElfResponse(userMessage) {
            // In a real app, this would be an API call to an AI 

            const greetings = [
                `Hello again! ${currentElf.name} here!`,
                `Hi there, my friend! It's ${currentElf.name}!`,
                `Merry Christmas! Or should I say, Merry almost-Christmas?`
            ];

            const questions = [
                `What's your favorite thing about Christmas?`,
                `Have you been nice this year? Santa's watching!`,
                `What would you like for Christmas? Maybe I can help!`,
                `Do you have any brothers or sisters?`,
                `What's your favorite Christmas movie?`
            ];

            const elfFacts = [
                `Did you know I love ${currentElf.hobbies[0]}? It's my favorite thing to do at the North Pole!`,
                `As a ${currentElf.job}, I get to see all the magic happen here!`,
                `My favorite treat is ${currentElf.treats}. Yum!`,
                `Fun fact about me: ${currentElf.funFact}`
            ];

            const encouraging = [
                `That's wonderful! Keep up the good work!`,
                `You're such a smart kid!`,
                `I'm so proud of you!`,
                `Santa's definitely going to bring you something special this year!`
            ];

            const randomResponses = [
                `Oh, that's interesting! Here at the North Pole, we...`,
                `What a great question! Let me think about that...`,
                `That reminds me of when I was helping Santa and we...`,
                `Oh my! That's so exciting! Did you know that...`,
                `Ha ha! That's funny! Speaking of funny things...`,
                `That's amazing! I wish we had that here at the North Pole.`,
                `That's so cool! Here at the North Pole, we're always busy with...`,
                `Oh, I see! That's very interesting. You know, Santa always says...`,
                `What a lovely thought! It makes me think of all the joy we spread at Christmas time.`
            ];

            // Combine all possible responses
            const allResponses = [...greetings, ...questions, ...elfFacts, ...encouraging, ...randomResponses];

            // If the user mentioned something specific, try to respond to it
            if (userMessage.toLowerCase().includes('hello') || userMessage.toLowerCase().includes('hi')) {
                return greetings[Math.floor(Math.random() * greetings.length)];
            } else if (userMessage.toLowerCase().includes('how are you')) {
                return `I'm wonderful, thank you for asking! The North Pole is always full of joy. How are YOU doing, my friend?`;
            } else if (userMessage.toLowerCase().includes('what do you do')) {
                return `I'm a ${currentElf.job} here at the North Pole! ${currentElfFacts[Math.floor(Math.random() * currentElfFacts.length)]}`;
            } else if (userMessage.toLowerCase().includes('favorite')) {
                return `My favorite thing is ${currentElf.hobbies[Math.floor(Math.random() * currentElf.hobbies.length)]}! What's your favorite thing to do?`;
            } else if (userMessage.toLowerCase().includes('santa')) {
                return `Oh, Santa is wonderful! He's always so busy this time of year. Did you know he has a special list just for kids like you?`;
            } else if (userMessage.toLowerCase().includes('christmas')) {
                return `Christmas is the most magical time of the year! Here at the North Pole, we work all year to make it special for children like you!`;
            } else {
                return allResponses[Math.floor(Math.random() * allResponses.length)];
            }
        }

        function renderInbox() {
            const inboxList = document.getElementById('inbox-list');
            if (messageHistory.length === 0) {
                inboxList.innerHTML = '<p>No letters yet. Start a conversation with your elf!</p>';
                return;
            }

            inboxList.innerHTML = '';
            // Group messages by conversation
            const conversations = [];
            let currentConversation = [];

            messageHistory.forEach(message => {
                currentConversation.push(message);
                // For demo, we'll just show all messages as separate letters
                conversations.push([...currentConversation]);
                currentConversation = [];
            });

            // Display each message as a letter preview
            messageHistory.forEach((message, index) => {
                const letter = document.createElement('div');
                letter.className = 'letter-preview fade-in';

                const sender = message.sender === 'user' ? 'You' : currentElf.name;
                const preview = message.text.substring(0, 50) + (message.text.length > 50 ? '...' : '');
                const date = new Date(message.timestamp).toLocaleDateString();

                letter.innerHTML = `
                    <h4>${sender}</h4>
                    <p>${preview}</p>
                    <div class="meta">
                        <span>${date}</span>
                        <span>${message.sender === 'user' ? 'Sent' : 'Received'}</span>
                    </div>
                `;

                letter.onclick = () => {
                    // In a real app, this would show the full conversation
                    alert(`Full message: ${message.text}`);
                };

                inboxList.appendChild(letter);
            });
        }

        // ===== COUNTDOWN TIMER =====
        function updateCountdown() {
            const now = new Date();
            const currentYear = now.getFullYear();

            // Set the Christmas date for this year
            let christmasDate = new Date(currentYear, 11, 25); // December is 11 (0-indexed)

            // If Christmas has passed, set it for next year
            if (now > christmasDate) {
                christmasDate = new Date(currentYear + 1, 11, 25);
            }

            const diff = christmasDate - now;

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById('days').textContent = days.toString().padStart(2, '0');
            document.getElementById('hours').textContent = hours.toString().padStart(2, '0');
            document.getElementById('minutes').textContent = minutes.toString().padStart(2, '0');
            document.getElementById('seconds').textContent = seconds.toString().padStart(2, '0');
        }

