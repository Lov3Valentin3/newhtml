    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='45' fill='%2300ff00'/><text x='50' y='60' font-size='50' text-anchor='middle' fill='%23000000'>❄️</text></svg>">

    <style>
        /* ===== CSS VARIABLES (DARK THEME) ===== */
        :root {
            /* Primary Colors */
            --primary: #00ff00;       /* Bright Green */
            --primary-dark: #008000;  /* Deep Green */
            --secondary: #8b0000;      /* Deep Red */
            --accent: #4b0082;         /* Deep Purple */
            --accent-light: #9400d3;   /* Bright Purple */
            --gold: #FFD700;           /* Gold */
            --blue: #0000ff;           /* Bright Blue */
            --blue-dark: #00008b;      /* Deep Blue */

            /* Background & Text */
            --bg-dark: #000000;        /* Black */
            --bg-darker: #101010;
            --bg-card: rgba(20, 20, 20, 0.9);
            --text: #ffffff;           /* White */
            --text-soft: #e0e0e0;      /* Soft White */
            --snow: #f8f8ff;           /* Snow White */

            /* Gradients */
            --gradient-primary: linear-gradient(135deg, var(--primary), var(--blue));
            --gradient-secondary: linear-gradient(135deg, var(--secondary), var(--accent));
            --gradient-gold: linear-gradient(135deg, var(--gold), #ffcc00);

            /* Shadows */
            --shadow-glow-green: 0 0 10px var(--primary), 0 0 20px var(--primary);
            --shadow-glow-gold: 0 0 10px var(--gold), 0 0 20px var(--gold);
            --shadow-glow-red: 0 0 10px var(--secondary), 0 0 20px var(--secondary);

            /* Typography */
            --font-main: 'Comic Sans MS', 'Chalkduster', 'cursive', sans-serif;
            --font-heading: 'Mountains of Christmas', 'Papyrus', fantasy;
        }

        /* ===== RESET & BASE STYLES ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: var(--font-main);
        }

        body {
            background: var(--bg-dark);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* ===== SNOW ANIMATION ===== */
        .snow {
            position: fixed;
            top: -10px;
            left: 0;
            width: 100%;
            height: 100vh;
            pointer-events: none;
            z-index: 1000;
            overflow: hidden;
        }

        .snowflake {
            position: absolute;
            color: var(--snow);
            user-select: none;
            pointer-events: none;
            animation: fall linear infinite;
            text-shadow: 0 0 5px var(--snow);
            font-size: 15px;
        }

        @keyframes fall {
            0% {
                transform: translateY(-100vh) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(100vh) rotate(360deg);
                opacity: 0;
            }
        }

        /* ===== TWINKLING LIGHTS ===== */
        .lights {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .light {
            position: absolute;
            background: var(--gold);
            border-radius: 50%;
            animation: twinkle 2s infinite ease-in-out;
            box-shadow: var(--shadow-glow-gold);
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.2); }
        }

        /* ===== CHRISTMAS DECORATIONS ===== */
        .decoration {
            position: fixed;
            z-index: 1;
            pointer-events: none;
        }

        .tree {
            bottom: -50px;
            left: -20px;
            width: 200px;
            height: 400px;
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 200"><polygon points="50,10 90,100 10,100" fill="%23006400"/><polygon points="50,40 80,130 20,130" fill="%23008000"/><polygon points="50,70 70,160 30,160" fill="%2300a000"/><rect x="45" y="170" width="10" height="30" fill="%238B4513"/></svg>') no-repeat;
            background-size: contain;
            opacity: 0.8;
        }

        .present {
            bottom: 20px;
            right: 20px;
            width: 80px;
            height: 60px;
            background: var(--gradient-primary);
            border-radius: 8px;
            box-shadow: var(--shadow-glow-green);
            transform: rotate(-5deg);
        }

        .present::before {
            content: '';
            position: absolute;
            top: -10px;
            left: 30%;
            width: 40%;
            height: 20px;
            background: var(--bg-dark);
            border-radius: 5px 5px 0 0;
        }

        .candy-cane {
            top: 100px;
            right: 10px;
            width: 20px;
            height: 120px;
            background: repeating-linear-gradient(
                45deg,
                var(--primary) 0px,
                var(--primary) 10px,
                var(--snow) 10px,
                var(--snow) 20px
            );
            border-radius: 10px;
            transform: rotate(45deg);
            box-shadow: var(--shadow-glow-green);
        }

        /* ===== LAYOUT ===== */
        .container {
            position: relative;
            z-index: 10;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            min-height: 100vh;
        }

        /* ===== HEADER ===== */
        header {
            text-align: center;
            padding: 40px 0;
            position: relative;
        }

        header h1 {
            font-size: 3rem;
            color: var(--gold);
            text-shadow: var(--shadow-glow-gold);
            margin-bottom: 10px;
            font-family: var(--font-heading);
            background: var(--gradient-gold);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: glow 2s infinite alternate;
        }

        @keyframes glow {
            from { text-shadow: var(--shadow-glow-gold); }
            to { text-shadow: 0 0 20px var(--gold), 0 0 30px var(--gold), 0 0 40px var(--gold); }
        }

        header p {
            font-size: 1.3rem;
            color: var(--text-soft);
            margin-bottom: 20px;
        }

        /* ===== BUTTONS ===== */
        .btn {
            display: inline-block;
            padding: 12px 24px;
            margin: 10px;
            border: none;
            border-radius: 30px;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            font-weight: bold;
            color: var(--bg-dark);
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }

        .btn-primary {
            background: var(--gradient-primary);
            box-shadow: var(--shadow-glow-green);
        }

        .btn-secondary {
            background: var(--gradient-secondary);
            box-shadow: var(--shadow-glow-red);
            color: var(--snow);
        }

        .btn-gold {
            background: var(--gradient-gold);
            box-shadow: var(--shadow-glow-gold);
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.4);
        }

        .btn:active {
            transform: translateY(1px);
        }

        /* ===== LANDING PAGE ===== */
        .landing {
            text-align: center;
            padding: 50px 0;
            position: relative;
        }

        .landing h2 {
            font-size: 2.2rem;
            margin-bottom: 20px;
            color: var(--gold);
            text-shadow: var(--shadow-glow-gold);
        }

        .landing p {
            font-size: 1.2rem;
            margin-bottom: 40px;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            color: var(--text-soft);
        }

        .landing-buttons {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 30px;
        }

        /* ===== FORMS ===== */
        .form-container {
            max-width: 500px;
            margin: 30px auto;
            background: var(--bg-card);
            padding: 30px;
            border-radius: 20px;
            border: 1px solid var(--gold);
            box-shadow: var(--shadow-glow-gold);
            position: relative;
        }

        .form-container::before {
            content: '❄️';
            position: absolute;
            top: -15px;
            left: 20px;
            font-size: 2rem;
            color: var(--gold);
            text-shadow: var(--shadow-glow-gold);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 1.1rem;
            color: var(--gold);
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px 15px;
            border-radius: 10px;
            border: 1px solid var(--primary);
            background: rgba(0, 0, 0, 0.5);
            color: var(--text);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: var(--gold);
            box-shadow: 0 0 10px var(--gold);
        }

        .form-group input::placeholder {
            color: var(--text-soft);
        }

        .form-actions {
            text-align: center;
            margin-top: 20px;
        }

        /* ===== ELF SELECTION ===== */
        .elf-selection-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .elf-selection-header h2 {
            color: var(--gold);
            margin-bottom: 10px;
            text-shadow: var(--shadow-glow-gold);
        }

        .elf-selection-header p {
            color: var(--text-soft);
            font-size: 1.1rem;
        }

        .elf-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .elf-card {
            background: var(--bg-card);
            border: 2px solid var(--primary);
            border-radius: 15px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .elf-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: var(--gradient-primary);
        }

        .elf-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px var(--primary);
            border-color: var(--gold);
        }

        .elf-card.selected {
            border-color: var(--gold);
            box-shadow: 0 0 20px var(--gold);
        }

        .elf-card img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 10px;
            display: block;
            border: 3px solid var(--gold);
            box-shadow: var(--shadow-glow-gold);
        }

        .elf-card h3 {
            color: var(--gold);
            margin-bottom: 8px;
            font-size: 1.3rem;
        }

        .elf-card .bio {
            color: var(--text-soft);
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .elf-card .details {
            font-size: 0.8rem;
            color: var(--text-soft);
        }

        .elf-card .details span {
            display: block;
            margin: 3px 0;
        }

        /* ===== DASHBOARD ===== */
        .dashboard {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 20px;
            margin-top: 30px;
        }

        .sidebar {
            background: var(--bg-card);
            border: 1px solid var(--gold);
            border-radius: 15px;
            padding: 20px;
            height: fit-content;
        }

        .sidebar h3 {
            color: var(--gold);
            margin-bottom: 20px;
            text-align: center;
            text-shadow: var(--shadow-glow-gold);
        }

        .elf-profile {
            text-align: center;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--gold);
        }

        .elf-profile img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 3px solid var(--gold);
            box-shadow: var(--shadow-glow-gold);
            margin-bottom: 10px;
        }

        .elf-profile h4 {
            color: var(--gold);
            margin-bottom: 5px;
        }

        .elf-profile p {
            color: var(--text-soft);
            font-size: 0.9rem;
        }

        .sidebar-nav {
            list-style: none;
        }

        .sidebar-nav li {
            margin-bottom: 10px;
        }

        .sidebar-nav a {
            display: block;
            padding: 10px;
            color: var(--text-soft);
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.3s ease;
            text-align: center;
        }

        .sidebar-nav a:hover, .sidebar-nav a.active {
            background: rgba(255, 215, 0, 0.2);
            color: var(--gold);
            box-shadow: 0 0 10px var(--gold);
        }

        .main-content {
            background: var(--bg-card);
            border: 1px solid var(--gold);
            border-radius: 15px;
            padding: 20px;
        }

        /* ===== CHAT INTERFACE ===== */
        .chat-container {
            height: 500px;
            overflow-y: auto;
            border: 1px solid var(--primary);
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 20px;
            background: rgba(0, 0, 0, 0.3);
            box-shadow: inset 0 0 10px var(--primary);
        }

        .chat-container::-webkit-scrollbar {
            width: 8px;
        }

        .chat-container::-webkit-scrollbar-track {
            background: var(--bg-dark);
        }

        .chat-container::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 4px;
        }

        .message {
            margin-bottom: 15px;
            padding: 12px 18px;
            border-radius: 20px;
            max-width: 80%;
            word-wrap: break-word;
            position: relative;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }

        .message.user {
            background: linear-gradient(135deg, var(--primary), var(--blue));
            margin-left: auto;
            border-bottom-right-radius: 5px;
            color: var(--bg-dark);
        }

        .message.elf {
            background: linear-gradient(135deg, var(--secondary), var(--accent));
            margin-right: auto;
            border-bottom-left-radius: 5px;
            color: var(--snow);
        }

        .message-input {
            display: flex;
            gap: 10px;
        }

        .message-input input {
            flex: 1;
            padding: 12px 15px;
            border-radius: 25px;
            border: 2px solid var(--gold);
            background: rgba(0, 0, 0, 0.5);
            color: var(--text);
            font-size: 1rem;
        }

        .message-input input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 10px var(--primary);
        }

        .message-input button {
            padding: 12px 20px;
            border-radius: 25px;
            border: none;
            background: var(--gradient-gold);
            color: var(--bg-dark);
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .message-input button:hover {
            transform: scale(1.05);
            box-shadow: var(--shadow-glow-gold);
        }

        /* ===== COUNTDOWN TIMER ===== */
        .countdown {
            text-align: center;
            padding: 30px;
            background: var(--bg-card);
            border: 1px solid var(--gold);
            border-radius: 15px;
            margin: 20px 0;
        }

        .countdown h3 {
            color: var(--gold);
            margin-bottom: 20px;
            text-shadow: var(--shadow-glow-gold);
        }

        .countdown-time {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .countdown-unit {
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid var(--gold);
            border-radius: 10px;
            padding: 15px 20px;
            min-width: 80px;
        }

        .countdown-unit div {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--primary);
            text-shadow: var(--shadow-glow-green);
        }

        .countdown-unit span {
            font-size: 0.9rem;
            color: var(--text-soft);
            display: block;
            margin-top: 5px;
        }

        /* ===== INBOX ===== */
        .inbox-list {
            max-height: 500px;
            overflow-y: auto;
        }

        .letter-preview {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--primary);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .letter-preview:hover {
            background: rgba(0, 255, 0, 0.1);
            border-color: var(--gold);
        }

        .letter-preview h4 {
            color: var(--gold);
            margin-bottom: 5px;
        }

        .letter-preview p {
            color: var(--text-soft);
            font-size: 0.9rem;
        }

        .letter-preview .meta {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: var(--text-soft);
            margin-top: 5px;
        }

        /* ===== DAILY INSPIRATION ===== */
        .inspiration-container {
            text-align: center;
            padding: 30px;
            background: var(--bg-card);
            border: 1px solid var(--gold);
            border-radius: 15px;
            margin: 20px 0;
            position: relative;
        }

        .inspiration-container::before {
            content: '✨';
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 2rem;
            color: var(--gold);
            text-shadow: var(--shadow-glow-gold);
        }

        .inspiration-container h2 {
            color: var(--gold);
            margin-bottom: 20px;
            text-shadow: var(--shadow-glow-gold);
        }

        .inspiration-quote {
            font-size: 1.4rem;
            color: var(--snow);
            font-style: italic;
            margin-bottom: 15px;
            padding: 20px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            border-left: 4px solid var(--gold);
        }

        .inspiration-author {
            color: var(--text-soft);
            font-size: 1rem;
        }

        /* ===== PARENT DASHBOARD ===== */
        .parent-controls {
            margin-top: 30px;
        }

        .parent-controls h3 {
            color: var(--gold);
            margin-bottom: 20px;
            text-shadow: var(--shadow-glow-gold);
        }

        .child-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .child-card {
            background: var(--bg-card);
            border: 1px solid var(--primary);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
        }

        .child-card img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 3px solid var(--gold);
            margin-bottom: 10px;
        }

        .child-card h4 {
            color: var(--gold);
            margin-bottom: 5px;
        }

        .child-card p {
            color: var(--text-soft);
            font-size: 0.9rem;
        }

        .subscription-info {
            background: var(--bg-card);
            border: 1px solid var(--gold);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
        }

        .subscription-info h4 {
            color: var(--gold);
            margin-bottom: 10px;
        }

        .subscription-info p {
            color: var(--text-soft);
            margin-bottom: 15px;
        }

        .subscription-plans {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .plan-card {
            background: var(--bg-card);
            border: 1px solid var(--gold);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
        }

        .plan-card h4 {
            color: var(--gold);
            margin-bottom: 10px;
        }

        .plan-card .price {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 10px;
        }

        .plan-card .features {
            list-style: none;
            margin-bottom: 15px;
            color: var(--text-soft);
        }

        .plan-card .features li {
            margin-bottom: 5px;
        }

        /* ===== RESPONSIVE DESIGN ===== */
        @media (max-width: 1024px) {
            .dashboard {
                grid-template-columns: 1fr;
            }

            .sidebar {
                order: 1;
            }

            .main-content {
                order: 0;
            }
        }

        @media (max-width: 768px) {
            header h1 {
                font-size: 2.2rem;
            }

            .landing-buttons {
                flex-direction: column;
                align-items: center;
            }

            .btn {
                width: 80%;
                margin: 8px 0;
            }

            .elf-grid {
                grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            }

            .chat-container {
                height: 400px;
            }

            .countdown-time {
                gap: 10px;
            }

            .countdown-unit {
                min-width: 70px;
                padding: 10px 15px;
            }

            .countdown-unit div {
                font-size: 2rem;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 10px;
            }

            header h1 {
                font-size: 1.8rem;
            }

            .landing h2 {
                font-size: 1.8rem;
            }

            .form-container {
                padding: 20px;
            }

            .elf-grid {
                grid-template-columns: 1fr;
            }

            .countdown-time {
                flex-direction: column;
                gap: 10px;
            }

