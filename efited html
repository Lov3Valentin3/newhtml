        // ===== MESSAGING SYSTEM =====
        function sendMessage() {
            const message = messageInput.value.trim();
            if (!message) return;

            // Add user message
            addUserMessage(message);
            messageInput.value = '';

            // Save to history
            messageHistory.push({
                sender: 'user',
                text: message,
                timestamp: new Date().toISOString()
            });

            // Simulate elf response
            setTimeout(() => {
                const elfResponse = generateElfResponse(message);
                addElfMessage(elfResponse);
                messageHistory.push({
                    sender: 'elf',
                    text: elfResponse,
                    timestamp: new Date().toISOString()
                });
            }, 1000);
        }

        function addUserMessage(message) {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message user fade-in';
